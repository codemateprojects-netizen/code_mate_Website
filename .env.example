# ───────────── Frontend (exposed to the browser — never put secrets here) ─────────────

# Public origin of the site. Used for canonical URLs, Open Graph URLs and sitemap.xml.
# sitemap.xml is only generated when this is set.
VITE_SITE_URL=https://www.your-domain.com

# Where forms POST to. Leave empty to use the bundled API (/api/inquiries).
# Set to a full URL if the API is hosted separately, or to a form provider
# endpoint that returns JSON { "ok": true }.
VITE_FORM_ENDPOINT=

# Optional booking link (Calendly, Cal.com, Google appointment page…). Empty = hidden.
VITE_BOOKING_URL=

# Optional company profile PDF, e.g. /syjen-code-profile.pdf placed in /public. Empty = hidden.
VITE_COMPANY_PROFILE_URL=

# ───────────── Server (server/index.ts — keep these secret) ─────────────

PORT=8787

# Submissions are appended to this JSON Lines file (default: server/data/inquiries.jsonl).
INQUIRY_STORE_PATH=

# Optional email notification via Resend (https://resend.com). All three are required to enable it.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Optional webhook (Slack, Zapier, Make, a CRM…) that receives each submission as JSON.
INQUIRY_WEBHOOK_URL=

# Comma-separated origins allowed to call the API cross-origin (only if the frontend is hosted elsewhere).
ALLOWED_ORIGINS=

# Set to true when running behind a reverse proxy / load balancer so rate limiting sees real client IPs.
TRUST_PROXY=false

# Per-IP rate limit for form submissions.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
